# Phase 3C ops-bot — copy to .env.local for local testing (never commit real values).
# On Railway these are set as service variables, not a file.

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated numeric Telegram user ids allowed to command the bot
TELEGRAM_ALLOWED_USER_IDS=8226073668

# Comma-separated numeric Telegram user ids allowed to run /build (feature dev —
# the agent writes NEW code). Subset of the allowlist; unset = same as the allowlist.
TELEGRAM_BUILD_OWNER_IDS=8226073668

# Fine-grained PAT: Actions=read/write, Issues=read/write, Contents=read (this repo only)
GITHUB_DISPATCH_TOKEN=

# Defaults are fine for ContentLoop; override only if needed
GITHUB_REPO=AliciaChen727/TM-contentloop
WORKFLOW_FILE=bug-fix-agent.yml
DEFAULT_BRANCH=main
DAILY_LIMIT=10
