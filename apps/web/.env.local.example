# ─── Meta App ───────────────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# OAuth redirect URI（要和 Meta App 設定的 Redirect URI 一致）
NEXT_PUBLIC_META_REDIRECT_URI=http://localhost:3000/auth/callback

# FB Page username 或數字 ID（用於直接取 Page token）
META_PAGE_IDENTIFIER=your_page_username_or_id

# ─── Firebase Client SDK（公開，可放 NEXT_PUBLIC_）────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=contentloop-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=contentloop-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=contentloop-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK（伺服器端，絕不公開）──────────────────
# 從 Service Account JSON 複製
FIREBASE_ADMIN_CLIENT_EMAIL=
# 注意：private_key 包含換行，要用雙引號包住整個值
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Anthropic Claude API ──────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key