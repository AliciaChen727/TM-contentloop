rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Video analysis uploads — existing path used by uploadVideoForAnalysis
    match /analysis/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Image uploads for Canva optimization — uploadImageForCanva
    match /uploads/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
